# coldchain-monitor environment variables.
#
# Every variable has a development-only default in infra/docker-compose.yml, so this file
# is optional for local development. To override values:
#   cp .env.example infra/.env     (Docker Compose reads the .env next to the compose file)
# Never commit a real .env file.

# --- MQTT (Mosquitto service accounts; usernames are fixed: simulator, ingestion) ---
MQTT_SIMULATOR_PASSWORD=change-me-simulator
MQTT_INGESTION_PASSWORD=change-me-ingestion

# --- Device simulator ---
# How often every simulated device publishes a reading (Spring Boot duration, e.g. 5s, 1m)
SIMULATOR_PUBLISH_INTERVAL=5s
# Per-device scenarios: NORMAL, POWER_OUTAGE, DOOR_LEFT_OPEN, DEVICE_OFFLINE, LOW_BATTERY,
# INVALID_PAYLOAD. Example: nile-fridge-01=POWER_OUTAGE,delta-fridge-02=LOW_BATTERY
SIMULATOR_SCENARIOS=

# --- Alert rules (stream-processor) ---
# A device is offline when nothing was received from it for this long
RULES_OFFLINE_AFTER=5m

# --- API (api-service) ---
# HMAC key that signs the JWTs: at least 32 random characters
JWT_SECRET=change-me-to-at-least-32-random-characters
# Lifetime of access tokens (JWT) and of refresh tokens (Spring Boot durations)
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Login rate limiting: failed attempts allowed per IP + username and per IP, per window
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_RATE_LIMIT_WINDOW=15m

# How often the outbox relay publishes pending device.config messages to Kafka
OUTBOX_POLL_INTERVAL=1s

# --- Grafana (http://localhost:3000; viewing needs no login, editing needs admin) ---
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Notifications (api-service) ---
# One notification per device and alert type per cooldown period
NOTIFICATION_COOLDOWN=30m
# Create a bot with @BotFather; leave empty to log notifications instead of sending them
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ClickHouse ---
CLICKHOUSE_USER=coldchain
CLICKHOUSE_PASSWORD=change-me-clickhouse

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- MySQL ---
MYSQL_USER=coldchain
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql-root
